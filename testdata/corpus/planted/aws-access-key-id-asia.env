# The output of `aws sts assume-role`, pasted into a shell profile so a session
# survives a new terminal. ASIA is the prefix STS issues, and the key being
# short-lived is not a reason to let it cross: it is valid for as long as
# anybody is still using the file.
export AWS_REGION=us-east-2
export AWS_ACCESS_KEY_ID=ASIA0SPILLGUARD31475
export AWS_SESSION_TOKEN=IQoJb3JpZ2luX2VjEJrSPILLGUARDwEaCXVzLWVhc3QtMiJH
