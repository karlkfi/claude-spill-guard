{
  "rules": [
    {
      "id": "aws-access-key-id",
      "family": "credential",
      "description": "AWS access key ID",
      "regex": "\\b((?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16})\\b",
      "group": 1,
      "keywords": ["AKIA", "ASIA", "ABIA", "ACCA", "A3T"],
      "entropy": 3.0,
      "validators": ["entropy"],
      "enabled": true
    },
    {
      "id": "github-token",
      "family": "credential",
      "description": "GitHub personal access, OAuth, user, server or refresh token",
      "regex": "\\b(gh[oprsu]_[A-Za-z0-9]{36})\\b",
      "group": 1,
      "keywords": ["ghp_", "gho_", "ghu_", "ghs_", "ghr_"],
      "entropy": 3.0,
      "validators": ["entropy"],
      "enabled": true
    },
    {
      "id": "github-fine-grained-pat",
      "family": "credential",
      "description": "GitHub fine-grained personal access token",
      "regex": "\\b(github_pat_[A-Za-z0-9_]{70,90})\\b",
      "group": 1,
      "keywords": ["github_pat_"],
      "entropy": 3.0,
      "validators": ["entropy"],
      "enabled": true
    },
    {
      "id": "slack-token",
      "family": "credential",
      "description": "Slack API token",
      "regex": "\\b(xox[abeprs]-[A-Za-z0-9-]{20,90})\\b",
      "group": 1,
      "keywords": ["xoxa-", "xoxb-", "xoxe-", "xoxp-", "xoxr-", "xoxs-"],
      "entropy": 3.0,
      "validators": ["entropy"],
      "enabled": true
    },
    {
      "id": "slack-webhook-url",
      "family": "credential",
      "description": "Slack incoming webhook URL",
      "regex": "https://hooks\\.slack\\.com/services/T[A-Za-z0-9_]{6,14}/B[A-Za-z0-9_]{6,14}/([A-Za-z0-9]{20,28})",
      "group": 1,
      "keywords": ["hooks.slack.com"],
      "entropy": 3.0,
      "validators": ["entropy"],
      "enabled": true
    },
    {
      "id": "stripe-live-secret-key",
      "family": "credential",
      "description": "Stripe live secret or restricted key",
      "regex": "\\b((?:sk|rk)_live_[A-Za-z0-9]{24,99})\\b",
      "group": 1,
      "keywords": ["sk_live_", "rk_live_"],
      "entropy": 3.0,
      "validators": ["entropy"],
      "enabled": true
    },
    {
      "id": "openai-api-key",
      "family": "credential",
      "description": "OpenAI API key",
      "regex": "\\b(sk-[A-Za-z0-9_-]{8,80}T3BlbkFJ[A-Za-z0-9_-]{8,80})\\b",
      "group": 1,
      "keywords": ["sk-"],
      "entropy": 3.0,
      "validators": ["entropy"],
      "enabled": true
    },
    {
      "id": "google-api-key",
      "family": "credential",
      "description": "Google API key",
      "regex": "\\b(AIza[A-Za-z0-9_-]{35})\\b",
      "group": 1,
      "keywords": ["AIza"],
      "entropy": 3.0,
      "validators": ["entropy"],
      "enabled": true
    },
    {
      "id": "private-key-block",
      "family": "credential",
      "description": "PEM private key header",
      "regex": "(-----BEGIN (?:RSA |DSA |EC |OPENSSH |PGP |SSH2 ENCRYPTED |ENCRYPTED )?PRIVATE KEY-----)[\\r\\n]+[A-Za-z0-9+/=]{32,}",
      "group": 1,
      "keywords": ["PRIVATE KEY"],
      "validators": [],
      "enabled": true
    },
    {
      "id": "jwt",
      "family": "credential",
      "description": "JSON Web Token",
      "regex": "\\b(eyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{10,})",
      "group": 1,
      "keywords": ["eyJ"],
      "entropy": 3.5,
      "validators": ["entropy"],
      "enabled": true
    },
    {
      "id": "payment-card",
      "family": "pii",
      "description": "Payment card number",
      "regex": "\\b(\\d{4}[ -]?\\d{4}[ -]?\\d{4}[ -]?\\d{1,4})\\b",
      "group": 1,
      "keywords": [],
      "labels": ["card", "cardnumber", "card_number", "cc", "creditcard", "credit card", "pan"],
      "validators": ["luhn", "card-placeholder", "context-label"],
      "enabled": false
    },
    {
      "id": "us-ssn",
      "family": "pii",
      "description": "US Social Security number",
      "regex": "\\b([0-8]\\d{2}-\\d{2}-\\d{4})\\b",
      "group": 1,
      "keywords": [],
      "labels": ["ssn", "social security", "social-security", "socialsecurity"],
      "validators": ["context-label"],
      "enabled": false
    },
    {
      "id": "cn-resident-id",
      "family": "pii",
      "description": "Chinese resident identity card number",
      "regex": "\\b(\\d{17}[0-9Xx])\\b",
      "group": 1,
      "keywords": [],
      "labels": ["id card", "idcard", "id_card", "national id", "resident id", "身份证"],
      "validators": ["mod-11", "context-label"],
      "enabled": false
    },
    {
      "id": "ipv4-public",
      "family": "pii",
      "description": "Public IPv4 address",
      "regex": "\\b((?:\\d{1,3}\\.){3}\\d{1,3})\\b",
      "group": 1,
      "keywords": [],
      "validators": ["reserved-range"],
      "enabled": false
    }
  ]
}
