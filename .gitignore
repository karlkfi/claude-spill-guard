# Build output
/bin/
/dist/
*.exe
/spill-guard

# Python (the backlog tooling)
__pycache__/
*.py[cod]

# Go
*.test
*.out

.DS_Store
tmp/
# Claude Code: ignore the .claude/ runtime tree — worktrees/, settings.local.json,
# session scratch — and allowlist the shareable config back in. `.claude/*` not
# `.claude/`: git does not descend into a fully ignored directory, so under the
# latter every negation below would be dead.
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/agents/
!.claude/skills/
!.claude/hooks/
# Credentials stay untracked even nested inside an allowlisted directory, since
# the last matching pattern wins.
.claude/**/.credentials.json

# Mutation-control scratch
mutant.log
